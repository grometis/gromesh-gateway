{
  "name": "@gromesh/compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "gromesh-compile": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "tsc -p tsconfig.build.json && node dist/cli.js test/fixtures/basic.state.json --envelope --version 1 --environment-id 00000000-0000-4000-8000-0000000000e1 --created-at 2026-01-01T00:00:00.000Z > ../../contracts/examples/snapshot.example.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.7.2",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  }
}
