{
  "name": "gromesh-gateway",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "pnpm test:guard && turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e": "pnpm --filter @gromesh/e2e test:e2e",
    "lint:contracts": "redocly lint contracts/control-plane.openapi.yaml contracts/agent-protocol.openapi.yaml contracts/control-plane-v2.openapi.yaml contracts/agent-protocol-v2.openapi.yaml",
    "dev:up": "node scripts/compose.mjs up -d",
    "dev:down": "node scripts/compose.mjs down",
    "smoke": "node scripts/smoke.mjs",
    "test:guard": "node --test scripts/stack-guard.test.mjs scripts/stack-entrypoints.test.mjs scripts/integration-databases.test.mjs scripts/kind-stack-guard.test.mjs scripts/disposable-docker.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.21",
    "turbo": "2.11.9",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "core-js"
    ],
    "overrides": {
      "@redocly/respect-core>@faker-js/faker": "10.6.0",
      "postman-collection>lodash": "4.18.1",
      "postman-collection>uuid": "11.1.1",
      "url>qs": "6.16.1",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
