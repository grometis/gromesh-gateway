{
  "name": "gromesh-gateway",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e": "pnpm --filter @gromesh/e2e test:e2e",
    "lint:contracts": "redocly lint contracts/control-plane.openapi.yaml contracts/agent-protocol.openapi.yaml contracts/control-plane-v2.openapi.yaml contracts/agent-protocol-v2.openapi.yaml",
    "dev:up": "docker compose -f deploy/compose/docker-compose.yml up -d",
    "dev:down": "docker compose -f deploy/compose/docker-compose.yml down",
    "smoke": "docker compose -f deploy/compose/docker-compose.yml run --rm smoke"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.21",
    "turbo": "2.11.9",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "core-js"
    ],
    "overrides": {
      "@redocly/respect-core>@faker-js/faker": "10.6.0",
      "postman-collection>lodash": "4.18.1",
      "postman-collection>uuid": "11.1.1",
      "url>qs": "6.16.1",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  }
}
