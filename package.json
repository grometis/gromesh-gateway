{
  "name": "gromesh-gateway",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e": "pnpm --filter @gromesh/e2e test:e2e",
    "lint:contracts": "redocly lint contracts/control-plane.openapi.yaml contracts/agent-protocol.openapi.yaml",
    "dev:up": "docker compose -f deploy/compose/docker-compose.yml up -d",
    "dev:down": "docker compose -f deploy/compose/docker-compose.yml down",
    "smoke": "docker compose -f deploy/compose/docker-compose.yml run --rm smoke"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.21",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "core-js"
    ],
    "overrides": {
      "@nestjs/platform-express>multer": "2.4.0",
      "express>path-to-regexp": "0.1.13",
      "@redocly/respect-core>@faker-js/faker": "10.6.0"
    }
  }
}
