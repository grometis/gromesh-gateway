{
  "name": "@gromesh/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.js"
  },
  "dependencies": {
    "@gromesh/compiler": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.38.3",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@swc/core": "1.10.1",
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.30.1",
    "typescript": "5.7.2",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
