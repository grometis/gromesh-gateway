{
  "name": "@gromesh/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.js",
    "catalog:generate": "node scripts/generate-plugin-catalog.mjs"
  },
  "dependencies": {
    "@clickhouse/client": "1.24.1",
    "@gromesh/compiler": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@node-rs/argon2": "2.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
