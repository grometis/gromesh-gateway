{
  "name": "@gromesh/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "pnpm gen:api && tsc -p tsconfig.json --noEmit",
    "gen:api": "openapi-typescript ../../contracts/control-plane.openapi.yaml -o src/api/schema.d.ts && openapi-typescript ../../contracts/control-plane-v2.openapi.yaml -o src/api/schema-v2.d.ts",
    "mock": "prism mock --port 4010 ../../contracts/control-plane.openapi.yaml",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@tanstack/react-query": "5.104.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@stoplight/prism-cli": "5.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
