{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gromesh:analytics-ingestion-v2:v1",
  "$defs": {
    "CanonicalUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "UInt64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "description": "UInt64 decimal <= 18446744073709551615, never coerced through a JS number."
    },
    "StoredEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "environmentId",
        "clusterId",
        "routeId",
        "serviceId",
        "consumerId",
        "ts",
        "method",
        "path",
        "status",
        "latencyKongMs",
        "latencyUpstreamMs",
        "latencyTotalMs",
        "clientIp",
        "requestSize",
        "responseSize",
        "retentionDays"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "environmentId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "clusterId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "routeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalUuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalUuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "consumerId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalUuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS",
            "TRACE",
            "CONNECT"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/[^?#]*$"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "latencyKongMs": {
          "type": "number",
          "minimum": 0
        },
        "latencyUpstreamMs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "latencyTotalMs": {
          "type": "number",
          "minimum": 0
        },
        "clientIp": {
          "type": "string",
          "format": "ipv6",
          "maxLength": 45
        },
        "requestSize": {
          "$ref": "#/$defs/UInt64"
        },
        "responseSize": {
          "$ref": "#/$defs/UInt64"
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      }
    },
    "IngestionCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "copyId",
        "podUid",
        "requestId",
        "event"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "copyId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "podUid": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "event": {
          "$ref": "#/$defs/StoredEvent"
        }
      }
    },
    "IngestionBatch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/IngestionCopy"
      }
    },
    "OpenStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "podUid"
      ],
      "properties": {
        "podUid": {
          "$ref": "#/$defs/CanonicalUuid"
        }
      }
    },
    "IngestionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "streamId",
        "batchId",
        "generation",
        "status",
        "storedCopies",
        "expiredCopies"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "streamId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "batchId": {
          "$ref": "#/$defs/CanonicalUuid"
        },
        "generation": {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
        },
        "status": {
          "const": "persisted"
        },
        "storedCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "expiredCopies": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
