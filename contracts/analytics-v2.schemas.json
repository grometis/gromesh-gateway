{
  "components": {
    "schemas": {
      "WorkspaceTrafficStats": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requests",
          "errors4xx",
          "errors5xx",
          "errorRate",
          "p50Ms",
          "p95Ms",
          "p99Ms"
        ],
        "properties": {
          "requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errors4xx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errors5xx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errorRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p50Ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "p95Ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "p99Ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "description": "Exact quantiles of total latency in ms. Errors are 4xx plus 5xx; errorRate is their count / requests, or zero without traffic. Empty quantiles are null. Overflow fails rather than rounding.",
        "allOf": [
          {
            "if": {
              "properties": {
                "requests": {
                  "const": 0
                }
              }
            },
            "then": {
              "properties": {
                "errors4xx": {
                  "const": 0
                },
                "errors5xx": {
                  "const": 0
                },
                "errorRate": {
                  "const": 0
                },
                "p50Ms": {
                  "type": "null"
                },
                "p95Ms": {
                  "type": "null"
                },
                "p99Ms": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "WorkspaceAnalyticsPoint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ts",
          "requests",
          "errors4xx",
          "errors5xx",
          "errorRate",
          "p50Ms",
          "p95Ms",
          "p99Ms"
        ],
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errors4xx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errors5xx": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errorRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "p50Ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "p95Ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "p99Ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "WorkspaceAnalyticsRevision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "epoch",
          "revision",
          "recordedAt"
        ],
        "properties": {
          "epoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "An immutable deployment candidate selected by event time. recordedAt is the transactionally recorded CP instant, never proof of when a pod started serving."
      },
      "WorkspaceAnalyticsSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "instanceId",
          "workspaceId",
          "from",
          "to",
          "generatedAt",
          "attributionVersion",
          "retention",
          "delivery",
          "interval",
          "totals",
          "series"
        ],
        "properties": {
          "scope": {
            "const": "workspace"
          },
          "instanceId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "attributionVersion": {
            "const": "route-history-v2"
          },
          "retention": {
            "const": "per-route-1-to-7-days"
          },
          "delivery": {
            "const": "best-effort"
          },
          "interval": {
            "type": "string",
            "enum": [
              "1m",
              "5m",
              "15m",
              "1h",
              "1d"
            ]
          },
          "totals": {
            "$ref": "#/components/schemas/WorkspaceTrafficStats"
          },
          "series": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "$ref": "#/components/schemas/WorkspaceAnalyticsPoint"
            },
            "description": "Ascending buckets anchored at from, last bucket may be partial. Empty buckets have zero counts and null quantiles."
          }
        }
      },
      "WorkspaceAnalyticsTimeseries": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "instanceId",
          "workspaceId",
          "from",
          "to",
          "generatedAt",
          "attributionVersion",
          "retention",
          "delivery",
          "interval",
          "series"
        ],
        "properties": {
          "scope": {
            "const": "workspace"
          },
          "instanceId": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "attributionVersion": {
            "const": "route-history-v2"
          },
          "retention": {
            "const": "per-route-1-to-7-days"
          },
