@NonCPS
String requireServiceIdentity(String expected){
 def auth=org.jenkinsci.plugins.workflow.cps.CpsThread.current()?.execution?.authentication2
 if(auth==null||auth.name!=expected||jenkins.model.Jenkins.get().getACL().hasPermission2(auth,jenkins.model.Jenkins.ADMINISTER))throw new IllegalStateException('DEDICATED_NON_ADMIN_RUN_IDENTITY_REQUIRED')
 return auth.name
}
def effectiveJenkinsUser=requireServiceIdentity('gromesh-ci-runner')
// The job's SCM revision must be an independently reviewed, immutable SHA.
// PR/branch code is checked out separately; it never supplies this orchestration.
properties([
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '30', daysToKeepStr: '30')),
  parameters([
    string(name: 'SHA', defaultValue: '', description: 'Exact candidate commit; independently checked against GitHub'),
    string(name: 'PR_NUMBER', defaultValue: '', description: 'PR job only'),
    string(name: 'BRANCH', defaultValue: '', description: 'Branch job only')
  ])
])
def jobs = [
  'gromesh-gateway/gromesh-ci/gromesh-main': 'main',
  'gromesh-gateway/gromesh-ci/gromesh-prs': 'pr',
  'gromesh-gateway/gromesh-ci/gromesh-branches': 'branch'
]
def profile = jobs[env.JOB_NAME]
if (!profile || !(params.SHA ==~ /[a-f0-9]{40}/)) error('INVALID_CI_JOB_OR_SHA')
def pipelineSha = scm.branches[0].name
if (!(pipelineSha ==~ /[a-f0-9]{40}/)) error('IMMUTABLE_REVIEWED_PIPELINE_REVISION_REQUIRED')
env.GROMESH_REVIEWED_PIPELINE_SHA=pipelineSha
def source = [repository: 'grometis/gromesh-gateway', sha: params.SHA, event: 'manual', branch: 'main', pr: null, baseSha: null]
def comparisonBase
def results = []
def tools = [:]
def bindings = []
def nonce = UUID.randomUUID().toString().replace('-', '')
def fullJob = env.JOB_NAME
def buildId = env.BUILD_NUMBER
def buildUrl = env.BUILD_URL
timeout(time: 6, unit: 'HOURS') {
  stage('Resolve exact GitHub source') {
    def resolved
    node('gromesh-coordinator') {
      withEnv(['GROMESH_PIPELINE_SHA='+pipelineSha,'PATH=/opt/gromesh/tools/node/bin:/opt/gromesh/tools/bin:/usr/local/bin:/usr/bin:/bin']) {
        def upstream=currentBuild.getBuildCauses('hudson.model.Cause$UpstreamCause')
        writeJSON(file:'source-request.json',json:[profile:profile,sha:params.SHA,pr:params.PR_NUMBER,branch:params.BRANCH,fromDiscovery:upstream.any{it.upstreamProject=='gromesh-gateway/gromesh-ci/gromesh-discovery'}])
        withCredentials([file(credentialsId:'gromesh-github-app-private-key',variable:'GROMESH_GITHUB_APP_KEY_FILE')]) {
          sh '/opt/gromesh/tools/node/bin/node /opt/gromesh/jenkins/source-resolver.mjs'
        }
        resolved=readJSON(file:'resolved-source.json',returnPojo:true)
        archiveArtifacts(artifacts:'resolved-source.json',fingerprint:true,allowEmptyArchive:false)
      }
    }
    source=resolved.source;comparisonBase=resolved.comparisonBase
    bindings = [
      'PATH=/opt/gromesh/tools/node/bin:/opt/gromesh/tools/bin:/usr/local/bin:/usr/bin:/bin',
      'DOCKER_HOST=unix:///run/user/1000/docker.sock', 'JENKINS_URL=https://jenkins.grometis.com/',
      'GROMESH_SOURCE_SHA=' + source.sha, 'GROMESH_SOURCE_EVENT=' + source.event,
      'GROMESH_SOURCE_BRANCH=' + source.branch, 'GROMESH_PR_NUMBER=' + (source.pr ?: ''),
      'GROMESH_PR_HEAD_SHA=' + (source.headSha ?: ''),
      'GROMESH_BASE_SHA=' + (source.baseSha ?: ''), 'GROMESH_DIFF_BASE_SHA=' + comparisonBase,
      'GROMESH_PIPELINE_SHA=' + pipelineSha, 'GROMESH_CI_RUN=' + nonce
    ]
  }
  def checkoutCandidate = {
    checkout([$class: 'GitSCM', branches: [[name: source.sha]],
      userRemoteConfigs: [[url: 'https://github.com/grometis/gromesh-gateway.git', refspec: '+refs/heads/*:refs/remotes/origin/* +refs/pull/*/head:refs/remotes/origin/pr/* +refs/pull/*/merge:refs/remotes/origin/pr-merge/*']],
      extensions: [[$class: 'CloneOption', noTags: true, shallow: false, timeout: 10]]])
    sh 'git config core.hooksPath .githooks'
  }
  def domain = profile == 'main' ? 'main' : 'untrusted'
  try {
    stage('Report CI started') {node('gromesh-coordinator'){withEnv(bindings){
      withCredentials([file(credentialsId:'gromesh-github-app-private-key',variable:'GROMESH_GITHUB_APP_KEY_FILE')]){
        sh '/opt/gromesh/tools/node/bin/node /opt/gromesh/jenkins/github-report.mjs begin'
      }
      archiveArtifacts(artifacts:'github-check.json',fingerprint:true,allowEmptyArchive:false)
    }}}
    node('gromesh-ci-' + domain + '-arm64') {
      dir('source') {
        checkoutCandidate()
        withEnv(bindings) {
          tools = readJSON(text: sh(returnStdout: true, script: '/opt/gromesh/tools/node/bin/node /opt/gromesh/jenkins/runner.mjs tools').trim(), returnPojo: true)
          for (def id in ['install','generated-client','contracts','typecheck','unit-integration','build','charts','ui-acceptance','agent','isolation','compose-e2e','kind-e2e','migration-regression','dependency-scan']) {
            stage(id) {
              def code = sh(returnStatus: true, script: '/opt/gromesh/tools/node/bin/node /opt/gromesh/jenkins/runner.mjs stage ' + id)
              def evidence = readJSON(file:'../results/' + id + '.json',returnPojo:true)
              dir('../results') { archiveArtifacts(artifacts:id+'/**,'+id+'.json',fingerprint:true,onlyIfSuccessful:false,allowEmptyArchive:false) }
              if(evidence.id!=id || evidence.sha!=source.sha || evidence.pipelineSha!=pipelineSha || evidence.build.id!=buildId || (code==0 && (evidence.exitCode!=0||evidence.complete!=true)))error('STAGE_EVIDENCE_IDENTITY_MISMATCH')
              results << evidence
              if (code != 0) error('CI_STAGE_FAILED: ' + id)
            }
          }
        }
      }
    }
    stage('Native image scan matrix') {
      def scans = [:]
      def matrix = [:]
      for (def arch in ['amd64','arm64']) {
        def architecture = arch
        matrix[architecture] = {
          node('gromesh-ci-' + domain + '-' + architecture) {
            dir('source') {
              checkoutCandidate()
              withEnv(bindings + ['SCAN_PLATFORM=linux/' + architecture]) {
                // Each native worker has its own clean dependency store/workspace.
                sh '/opt/gromesh/tools/node/bin/node /opt/gromesh/jenkins/runner.mjs stage install'
                def code = sh(returnStatus: true, script: '/opt/gromesh/tools/node/bin/node /opt/gromesh/jenkins/runner.mjs stage image-scan')
                def evidence=readJSON(file:'../results/image-scan.json',returnPojo:true)
                dir('../results') { archiveArtifacts(artifacts:'image-scan/**,image-scan.json',fingerprint:true,onlyIfSuccessful:false,allowEmptyArchive:false) }
                if(evidence.sha!=source.sha||evidence.pipelineSha!=pipelineSha||(code==0&&(evidence.exitCode!=0||evidence.complete!=true)))error('SCAN_EVIDENCE_IDENTITY_MISMATCH')
                scans[architecture] = evidence
                if (code != 0) error('IMAGE_SCAN_FAILED: ' + architecture)
              }
            }
          }
        }
      }
      parallel matrix
      if(scans.values().any{it.complete!=true})error('SCAN_EVIDENCE_INCOMPLETE')
      results << [id:'image-scan', status:'SUCCESS', exitCode:0, durationMs:scans.values().collect { it.durationMs }.sum(), complete:true,artifacts:scans.arm64.artifacts,platformEvidence:scans, platforms:['linux/amd64','linux/arm64']]
    }
  } finally {
    // The coordinator never checks out or executes the untrusted source tree.
    timeout(time: 2, unit: 'MINUTES') {
      node('gromesh-coordinator') {
        withEnv(bindings) {
          def report = [schema:'gromesh-jenkins-ci/v1',source:source,pipelineSha:pipelineSha,build:[job:fullJob,id:buildId,url:buildUrl],stages:results,tools:tools]
          writeJSON(file:'ci-result.json',json:report,pretty:2)
          def complete = sh(returnStatus:true,script:'/opt/gromesh/tools/node/bin/node /opt/gromesh/jenkins/runner.mjs verify-report ci-result.json') == 0
          archiveArtifacts(artifacts:'ci-result.json',fingerprint:true,onlyIfSuccessful:false)
          if(complete && source.event=='push' && source.branch=='main') {
            withCredentials([file(credentialsId:'gromesh-ci-attestation-signing-key',variable:'GROMESH_CI_SIGNING_KEY_FILE')]) {
              sh '/opt/gromesh/tools/node/bin/node /opt/gromesh/jenkins/attest.mjs'
            }
            archiveArtifacts(artifacts:'ci-attestation.json',fingerprint:true,allowEmptyArchive:false)
          }
          echo('Final GitHub conclusion is deferred until the Jenkins Run terminates; the protected status job reconciles it.')
          if (!complete) error('CI_INCOMPLETE; GitHub Actions remains authoritative')
        }
      }
    }
  }
}
