# N2 reference lab (environment A). Verified 2026-10-26 against the kind v0.33.0 release notes (node images and
# digests), the Cilium v1.20.4 release (image digests), docs.cilium.io/en/v1.20 (Kubernetes 1.33-1.36 e2e tested;
# kernel >= 5.10) and the OCI chart digest from `helm pull`. Kubernetes 1.37 is outside Cilium 1.20's matrix.
KIND_VERSION=v0.33.0
# Release binaries (kind-<os>-<arch>.sha256sum of v0.33.0); a source build (e.g. Homebrew) reports the version only.
KIND_SHA256_LINUX_AMD64=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_SHA256_LINUX_ARM64=20022bee6cfcd5086cb7234d218e3454e6090022f2a8f55d1fa7fcf42c3867a2
KIND_SHA256_DARWIN_ARM64=0c8c7dbe5e23594a198b786c4bc13dacc101fa6196b0cb0b23a1ca44e61f4b4f
KIND_SHA256_DARWIN_AMD64=5a99f26f57246dc9319dd294803313197a0f34d33c525b3ea8b655db5916ece0
KUBERNETES_VERSION=v1.36.4
NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
CILIUM_VERSION=1.20.4
CILIUM_CHART=oci://quay.io/cilium/charts/cilium
CILIUM_CHART_DIGEST=sha256:712e1f65bf30533d117d1996ac3ace3efdb2521302d31ee887b1e45806bd6b64
# sha256 of cilium-1.20.4.tgz as pulled with that digest: lets CILIUM_CHART_TGZ point at a pre-pulled copy.
CILIUM_CHART_TGZ_SHA256=505abff8385811df1a949776fc42e9f10697989a332acc86d6e8933efcb855ed
CILIUM_IMAGE_DIGEST=sha256:20fe92e4c86641233a450098c158d2d29085f3419931ab6bf681d2485dedf16e
CILIUM_OPERATOR_GENERIC_DIGEST=sha256:7a7a3489dc66ad67e420d285c8a8d2e169b0957ad15e120f593d27081bf38d82
# Every lab fixture (servers, DNS, probe) is the same Node image as the rest of e2e.
FIXTURE_IMAGE=node:24.18.0-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd
CLUSTER_NAME=gromesh-n2-lab
# Images the external lab runs besides the ones it builds, all by digest (the compose stack pins the same ClickHouse
# and Vector). KONG_IMAGE_REF: kong-v3.9.4-n2-2 (b3f097e), the first build whose route guard accepts the v2 canary.
KONG_IMAGE_REF=ghcr.io/grometis/gromesh-kong@sha256:fcd9b00d051c5d36e042bbd1ad996bd8293d818c3aa4c97cdf1cbc01737a34fc
PG_IMAGE=postgres:16-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8.33.6-alpine@sha256:87e0a5b72f5465b18eacca7c76850e7ff551c9795c50e451f5646299e5e24146
VECTOR_IMAGE=timberio/vector:0.57.0-alpine@sha256:19e3526faf4d4b1ed0c28a0d68d4cc3a1e13e437099986a5b7a768707907497c
