{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "kong": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "workerProcesses": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "dns": {
          "type": "object",
          "required": [
            "notFoundTtl",
            "errorTtl",
            "staleTtl"
          ],
          "additionalProperties": false,
          "properties": {
            "notFoundTtl": {
              "type": "integer",
              "minimum": 0
            },
            "errorTtl": {
              "type": "integer",
              "minimum": 0
            },
            "staleTtl": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "realIpHeader": {
          "type": "string",
          "pattern": "^([A-Za-z0-9!#$%&'*+.^_`|~-]+)?$"
        },
        "trustedIps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}(/([1-9]|[12][0-9]|3[0-2]))?|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]*(/([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))?)$"
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "controlPlaneUrl": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "initResources": {
      "$ref": "#/definitions/resources"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "enum": [
            "Cluster",
            "Local"
          ]
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "httpLogEndpoint": {
          "type": "string"
        },
        "clusterId": {
          "type": "string"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "keyNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "clickhouse": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayJob": {
          "type": "string",
          "minLength": 1
        },
        "collectorJob": {
          "type": "string",
          "minLength": 1
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "proxyPeers": {
          "$ref": "#/definitions/peers"
        },
        "controlPlanePeers": {
          "$ref": "#/definitions/peers"
        },
        "collectorPeers": {
          "$ref": "#/definitions/peers"
        },
        "dnsPeers": {
          "$ref": "#/definitions/peers"
        },
        "upstreams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cidr",
              "ports"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "minLength": 1
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "peers": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1
      }
    }
  }
}
