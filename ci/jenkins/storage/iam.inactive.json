{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Deny","Action":"s3:*","Resource":["arn:aws:s3:::REQUIRES_PRIVATE_BUCKET","arn:aws:s3:::REQUIRES_PRIVATE_BUCKET/*"],"Condition":{"Bool":{"aws:SecureTransport":"false"}}},
    {"Effect":"Allow","Action":["s3:GetBucketLocation"],"Resource":"arn:aws:s3:::REQUIRES_PRIVATE_BUCKET"},
    {"Effect":"Allow","Action":["s3:ListBucket","s3:ListBucketMultipartUploads"],"Resource":"arn:aws:s3:::REQUIRES_PRIVATE_BUCKET","Condition":{"StringLike":{"s3:prefix":["jenkins-gromesh/*"]}}},
    {"Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:DeleteObject","s3:AbortMultipartUpload","s3:ListMultipartUploadParts"],"Resource":"arn:aws:s3:::REQUIRES_PRIVATE_BUCKET/jenkins-gromesh/*"}
  ]
}
